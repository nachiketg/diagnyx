<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Diagnyx</AssemblyName>
    <RootNamespace>Diagnyx</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata (DX-019) -->
  <PropertyGroup>
    <PackageId>diagnyx-dotnet</PackageId>
    <Version>0.1.0</Version>
    <Authors>Nachiket Ghatole</Authors>
    <Description>Thin .NET client for the Diagnyx structured logging CLI. Provides DiagnyxLogger, which calls the diagnyx binary to write structured JSON log entries to any configured sink (file, SQLite, PostgreSQL, MySQL, SQL Server).</Description>
    <PackageTags>logging;structured-logging;diagnyx;observability;json;ndjson</PackageTags>
    <PackageProjectUrl>https://github.com/nachiketg/diagnyx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nachiketg/diagnyx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Platform binaries staged into runtimes/{rid}/native/diagnyx.bin by the
    release workflow before packing (DX-017). Absent locally, so each
    Update below matches nothing in a normal dev build. Packed under the
    ".bin" name (not the CLI's real "diagnyx"/"diagnyx.exe" name) because
    NuGet's pack target appends the source item's own relative path
    underneath PackagePath whenever the source file has no extension,
    which double-nests extensionless native executables; CliRunner's
    FindBundled() looks for this same "diagnyx.bin" name.
  -->
  <ItemGroup>
    <None Update="runtimes/win-x64/native/diagnyx.bin"   Pack="true" PackagePath="runtimes/win-x64/native/diagnyx.bin" />
    <None Update="runtimes/linux-x64/native/diagnyx.bin" Pack="true" PackagePath="runtimes/linux-x64/native/diagnyx.bin" />
    <None Update="runtimes/osx-arm64/native/diagnyx.bin" Pack="true" PackagePath="runtimes/osx-arm64/native/diagnyx.bin" />
  </ItemGroup>

  <!-- tests/ is a sibling project; exclude it from this library's glob patterns -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
